---
import BaseLayout from './BaseLayout.astro';
import { getTool, tools, categories } from '../data/tools';
import ToolCard from '../components/ToolCard.astro';
import Icon from '../components/Icon.astro';
import ToolIcon from '../components/ToolIcon.astro';
interface Props {
  slug: string;
}
const tool = getTool(Astro.props.slug);
const groups = categories.filter((category) => category !== 'All tools');
---

<BaseLayout title={tool.title} description={tool.summary} shell="app">
  <div class="container app-shell">
    <nav class="tool-nav" id="tool-nav" aria-label="All tools">
      {groups.map((category) => (
        <>
          <p class="tool-nav-group">{category}</p>
          <ul>
            {tools
              .filter((item) => item.category === category)
              .map((item) => (
                <li>
                  <a
                    href={`/tools/${item.slug}/`}
                    aria-current={item.slug === tool.slug ? 'page' : undefined}
                  >
                    <span class="nav-symbol" aria-hidden="true">
                      <ToolIcon slug={item.slug} size={18} />
                    </span>
                    {item.shortTitle}
                  </a>
                </li>
              ))}
          </ul>
        </>
      ))}
    </nav>
    <div class="tool-page" data-layout={tool.layout}>
      <div class="tool-head">
        <button
          type="button"
          class="icon-button sidebar-toggle js-only"
          id="sidebar-toggle"
          aria-controls="tool-nav"
          aria-expanded="true"
          aria-label="Tool list"
          title="Show or hide the tool list"
        >
          <Icon name="sidebar" />
        </button>
        <div class="tool-title">
          <span class="tool-symbol tool-symbol-3d" aria-hidden="true">
            <img
              src={`/images/tools/${tool.slug}.jpg`}
              alt=""
              class="tool-3d-avatar"
              width="44"
              height="44"
            />
          </span>
          <div>
            <nav class="breadcrumbs" aria-label="Breadcrumb">
              <a href="/tools/">Tools</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{tool.category}</span>
            </nav>
            <h1>{tool.title}</h1>
          </div>
        </div>
        <div class="tool-head-actions">
          <button
            id="favorite-toggle"
            class="text-button save-toggle"
            data-slug={tool.slug}
            aria-pressed="false"
          >
            <Icon name="star" size={16} />
            <span class="save-label">Save tool</span>
          </button>
        </div>
        <div class="tool-summary">
          <p>{tool.summary}</p>
          <span class="pill">
            <Icon name="shield" size={16} />
            Processed in your browser
            <span class="pill-more">· No uploads · No saved input</span>
          </span>
        </div>
      </div>
      <div class="tool-main">
        <div class="tool-primary">
          <section class="tool-workspace" aria-label={tool.title}>
            <div class="workspace-body">
              <slot />
            </div>
          </section>
          <noscript>
            <p class="notice">
              Enable JavaScript to use this interactive tool. The instructions
              below are still available.
            </p>
          </noscript>
        </div>
        <div class="guide-panels">
          <section class="panel">
            <div class="badge">Quick start</div>
            <h2>How to use {tool.shortTitle}</h2>
            <ol>
              {tool.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
            <h3>Example</h3>
            <pre>{tool.example}</pre>
          </section>
          <aside class="panel">
            <div class="badge">Good to know</div>
            <h2>Formats &amp; limitations</h2>
            <p>{tool.note}</p>
            <p>
              Input and results are held in this tab’s memory. Reloading clears
              them. Copying puts the result on your system clipboard.
            </p>
          </aside>
        </div>
        <section class="related-section">
          <div class="section-heading">
            <h2>Next in your workflow</h2>
            <a class="text-link" href="/tools/">
              All tools <Icon name="arrow" size={16} />
            </a>
          </div>
          <div class="tool-grid">
            {tool.related.map((slug) => (
              <ToolCard tool={getTool(slug)} />
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
<script>
  const sidebar = document.getElementById('sidebar-toggle');
  const syncSidebar = () =>
    sidebar?.setAttribute(
      'aria-expanded',
      String(document.documentElement.dataset.sidebar !== 'collapsed'),
    );
  syncSidebar();
  sidebar?.addEventListener('click', () => {
    const collapsed = document.documentElement.dataset.sidebar !== 'collapsed';
    if (collapsed) document.documentElement.dataset.sidebar = 'collapsed';
    else delete document.documentElement.dataset.sidebar;
    try {
      localStorage.setItem('infratrove-sidebar', collapsed ? 'collapsed' : '');
    } catch {}
    syncSidebar();
  });
  const button = document.getElementById('favorite-toggle');
  const label = button?.querySelector('.save-label');
  const slug = button?.dataset.slug || '';
  function read(): string[] {
    try {
      const value = JSON.parse(
        localStorage.getItem('infratrove-favorites') || '[]',
      );
      return Array.isArray(value)
        ? value.filter((x) => typeof x === 'string')
        : [];
    } catch {
      return [];
    }
  }
  function update() {
    const saved = read().includes(slug);
    button?.setAttribute('aria-pressed', String(saved));
    if (label) label.textContent = saved ? 'Saved' : 'Save tool';
  }
  update();
  button?.addEventListener('click', () => {
    const saved = read();
    try {
      localStorage.setItem(
        'infratrove-favorites',
        JSON.stringify(
          saved.includes(slug)
            ? saved.filter((x) => x !== slug)
            : [...saved, slug],
        ),
      );
      update();
    } catch {
      if (label) label.textContent = 'Storage unavailable';
    }
  });
</script>
