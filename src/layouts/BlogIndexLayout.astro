---
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { blogText } from '../lib/i18n';
import { blogHref, getPosts, langNames, langs, type Lang } from '../lib/blog';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = blogText[lang];
const posts = await getPosts(lang);
const categories = [...new Set(posts.map((post) => post.data.category))];
---

<BaseLayout
  title={t.indexTitle}
  description={t.indexDescription}
  alternates={langs.map((item) => ({ lang: item, path: blogHref(item) }))}
>
  <div class="container page-section blog-content" lang={lang}>
    <header class="blog-head banner">
      <div class="eyebrow">{t.badge}</div>
      <h1>{t.indexTitle}</h1>
      <p class="page-intro">{t.indexIntro}</p>
    </header>
    <div class="blog-controls">
      <div class="tabs js-only" role="group" aria-label={t.filterLabel}>
        <button class="chip active" data-filter="" aria-pressed="true">
          {t.all}
        </button>
        {categories.map((category) => (
          <button class="chip" data-filter={category} aria-pressed="false">
            {category}
          </button>
        ))}
      </div>
      <nav class="segmented" aria-label={t.languageLabel}>
        {langs.map((item) => (
          <a
            href={blogHref(item)}
            lang={item}
            hreflang={item}
            aria-current={item === lang ? 'page' : undefined}
          >
            {langNames[item]}
          </a>
        ))}
      </nav>
    </div>
    <p
      class="blog-count js-only"
      role="status"
      data-template={t.resultCount}
      data-total={posts.length}
    ></p>
    <div class="post-grid">
      {posts.map((post, i) => (
        <PostCard post={post} heading="h2" latest={i === 0} />
      ))}
    </div>
  </div>
</BaseLayout>
<script>
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>('.tabs [data-filter]'),
  ];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const count = document.querySelector<HTMLElement>('.blog-count')!;
  const categories = new Set(buttons.map((button) => button.dataset.filter));

  function apply(category: string, push: boolean) {
    if (!categories.has(category)) category = '';
    buttons.forEach((item) => {
      const on = (item.dataset.filter || '') === category;
      item.classList.toggle('active', on);
      item.setAttribute('aria-pressed', String(on));
    });
    let shown = 0;
    cards.forEach((card) => {
      const match = category === '' || card.dataset.category === category;
      card.hidden = !match;
      if (match) shown += 1;
    });
    // Only announce once someone filters; the unfiltered page needs no status.
    count.textContent = category
      ? (count.dataset.template ?? '')
          .replace('{n}', String(shown))
          .replace('{total}', count.dataset.total ?? '')
      : '';
    if (push) {
      const url = new URL(location.href);
      if (category) url.searchParams.set('category', category);
      else url.searchParams.delete('category');
      history.replaceState(null, '', url);
    }
  }

  document
    .querySelectorAll<HTMLButtonElement>('[data-filter]')
    .forEach((button) =>
      button.addEventListener('click', () =>
        apply(button.dataset.filter || '', true),
      ),
    );
  apply(new URLSearchParams(location.search).get('category') ?? '', false);
</script>
