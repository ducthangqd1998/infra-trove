---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This page could not be found. Find the tool you need in the InfraTrove directory."
  noindex
>
  <div class="container page-section">
    <div class="eyebrow">404 · Wrong turn</div>
    <h1>This one's missing.</h1>
    <p class="page-intro">
      That page may have moved, or the address may have a typo.
    </p>
    <a class="button" href="/tools/">
      Find a tool
    </a>
  </div>
</BaseLayout>
