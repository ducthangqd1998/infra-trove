---
import BaseLayout from '../layouts/BaseLayout.astro';
import Directory from '../components/Directory.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { getPosts } from '../lib/blog';

const posts = (await getPosts('en')).slice(0, 3);
const siteUrl = Astro.site?.toString() || 'https://infratrove.com';
const homeStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'InfraTrove',
    url: siteUrl,
    description:
      'Format JSON, compare text, generate passwords and convert everyday formats. Fast, free tools that run in your browser.',
    potentialAction: {
      '@type': 'SearchAction',
      target: `${siteUrl}tools/#tool-search`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'InfraTrove',
    url: siteUrl,
    logo: new URL('/favicon.svg', siteUrl).toString(),
  },
];

const cols = 28;
const rows = 12;
const cell = 8;
const heights = [
  3, 4, 6, 8, 9, 8, 7, 8, 9, 7, 6, 5, 4, 3, 3, 2, 2, 2, 3, 4, 5, 7, 9, 10, 10,
  9, 7, 5,
];
const pixels = heights.flatMap((height, c) =>
  Array.from({ length: rows }, (_, r) => ({
    x: c * cell,
    y: (rows - 1 - r) * cell,
    cls: r >= height ? 'px-ghost' : r < 4 ? 'px-1' : r < 8 ? 'px-2' : 'px-3',
    top: r === height - 1,
    delay: `${((c * 0.37) % 2.6).toFixed(2)}s`,
  })),
);
---

<BaseLayout
  title="Free Online Tools for Everyday Work"
  description="Format JSON, compare text, generate passwords and convert everyday formats. Fast, free tools that run in your browser."
  structuredData={homeStructuredData}
>
  <div class="container">
    <section class="hero">
      <div class="hero-main">
        <div class="eyebrow">
          <span class="status-dot"></span> In-browser developer suite
        </div>
        <h1>
          Your everyday
          <br />
          <span class="hero-accent">workbench.</span>
        </h1>
        <p class="hero-description">
          Format, compare, generate and convert.
          <br />
          Small tools that get you back to the bigger things.
        </p>

        <div class="hero-actions">
          <a class="button" href="/tools/">
            Browse all tools <Icon name="arrow" size={16} />
          </a>
          <a class="button secondary" href="/blog/">
            Read the guides
          </a>
        </div>
        <div class="hero-trust">
          <span>
            <Icon name="check" size={16} /> Always free
          </span>
          <span>
            <Icon name="check" size={16} /> No sign-up
          </span>
          <span>
            <Icon name="check" size={16} /> Runs locally
          </span>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="dash">
          <div class="dash-side">
            <div class="dash-brand">
              <span class="brand-mark">
                <Icon name="layers" size={12} />
              </span>
              infratrove
            </div>
            <div class="dash-search">
              Search <kbd>⌘ K</kbd>
            </div>
            <p class="dash-group">Tools</p>
            <ul>
              <li class="on">JSON Formatter</li>
              <li>Text Compare</li>
              <li>Cron Generator</li>
              <li>Base64 Encoder</li>
            </ul>
            <p class="dash-group">Guides</p>
            <ul>
              <li>English</li>
              <li>Tiếng Việt</li>
            </ul>
          </div>
          <div class="dash-main">
            <div class="dash-crumb">
              Tools › <b>JSON Formatter</b>
            </div>
            <div class="dash-banner">
              <div>
                <b>Format JSON right in your tab</b>
                <span>Nothing is uploaded. Nothing is saved.</span>
              </div>
              <span class="dash-btn">Format JSON →</span>
            </div>
            <div class="dash-cards">
              <div class="dash-card">
                <div class="dash-card-head">
                  JSON <span class="dash-tag">Input → Output</span>
                </div>
                <pre class="dash-code">{'{\n  '}"name": <span class="v">"api"</span>{',\n  '}"free": <span class="v">true</span>{',\n  '}"tools": <span class="v">8</span>{'\n}'}</pre>
              </div>
              <div class="dash-card">
                <div class="dash-card-head">
                  Work done <span class="dash-tag">In your browser</span>
                </div>
                <svg
                  class="px"
                  aria-hidden="true"
                  role="img"
                  aria-label="Decorative client-side activity chart"
                  viewBox={`0 0 ${cols * cell} ${rows * cell}`}
                  focusable="false"
                >
                  {pixels.map((pixel) => (
                    <rect
                      class:list={[pixel.cls, { 'px-top': pixel.top }]}
                      x={pixel.x}
                      y={pixel.y}
                      width="8"
                      height="8"
                      rx="1.5"
                      style={pixel.top ? `--d:${pixel.delay}` : undefined}
                    />
                  ))}
                </svg>
                <p class="dash-foot">Your device does the work.</p>
              </div>
            </div>
            <div class="dash-card">
              <div class="dash-card-head">
                How it works <span class="dash-tag">Live</span>
              </div>
              <div class="dash-flow">
                <span class="dash-node">paste</span>
                <i></i>
                <span class="dash-node on">this tab</span>
                <i></i>
                <span class="dash-node">copy</span>
              </div>
            </div>
          </div>
        </div>
        <span class="hero-chip">
          <Icon name="shield" size={16} /> Your input stays in your browser
        </span>
      </div>
    </section>

    <section class="tools-section">
      <div class="section-heading">
        <div>
          <h2>A shortcut for your next task.</h2>
        </div>
        <span class="section-note">Eight useful tools. Zero hoops.</span>
      </div>
      <Directory />
    </section>

    <section class="guides-section">
      <div class="section-heading">
        <div>
          <h2>Guides &amp; references</h2>
        </div>
        <a class="text-link" href="/blog/">
          All guides <Icon name="arrow" size={16} />
        </a>
      </div>
      <div class="post-grid">
        {posts.map((post, i) => (
          <PostCard post={post} tone={i} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
