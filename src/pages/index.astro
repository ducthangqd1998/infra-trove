---
import BaseLayout from '../layouts/BaseLayout.astro';
import Directory from '../components/Directory.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { getPosts } from '../lib/blog';
const posts = (await getPosts('en')).slice(0, 3);
// Decorative pixel chart: columns scale up and down like load, hot at the top.
const cols = 24;
const rows = 11;
const cell = 10;
const heights = Array.from({ length: cols }, (_, i) =>
  Math.max(
    2,
    Math.min(
      rows - 1,
      Math.round(5 + 3.2 * Math.sin(i / 2.6) + 1.8 * Math.sin(i / 1.1 + 1)),
    ),
  ),
);
const pixels = heights.flatMap((height, c) =>
  Array.from({ length: rows }, (_, r) => ({
    x: c * cell,
    y: (rows - 1 - r) * cell,
    cls: r >= height ? 'px-ghost' : r < 4 ? 'px-1' : r < 8 ? 'px-2' : 'px-3',
    top: r === height - 1,
    delay: `${((c * 0.37) % 2.6).toFixed(2)}s`,
  })),
);
---

<BaseLayout
  title="Free Online Tools for Everyday Work"
  description="Format JSON, compare text, generate passwords and convert everyday formats. Fast, free tools that run in your browser."
>
  <div class="container">
    <section class="hero">
      <div class="hero-main">
        <div class="eyebrow">
          <span class="status-dot"></span> Your everyday utility kit
        </div>
        <h1>
          Your everyday
          <br />
          <span class="hero-accent">workbench.</span>
        </h1>
        <p class="hero-description">
          Format, compare, generate and convert.
          <br />
          Small tools that get you back to the bigger things.
        </p>
        <div class="hero-search">
          <label for="tool-search">Search tools</label>
          <div class="search-control">
            <Icon name="search" />
            <input
              id="tool-search"
              type="search"
              placeholder="Search a tool or task…"
              autocomplete="off"
            />
            <kbd>⌘ K</kbd>
          </div>
        </div>
        <div class="hero-actions">
          <a class="button" href="/tools/">
            Browse all tools <Icon name="arrow" size={16} />
          </a>
          <a class="button secondary" href="/blog/">
            Read the guides
          </a>
        </div>
        <div class="hero-trust">
          <span>
            <Icon name="check" size={16} /> Always free
          </span>
          <span>
            <Icon name="check" size={16} /> No sign-up
          </span>
          <span>
            <Icon name="check" size={16} /> Runs locally
          </span>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="dash">
          <div class="dash-side">
            <div class="dash-brand">
              <span class="brand-mark">
                <Icon name="layers" size={12} />
              </span>
              infratrove
            </div>
            <div class="dash-search">
              Search <kbd>⌘ K</kbd>
            </div>
            <p class="dash-group">Tools</p>
            <ul>
              <li class="on">JSON Formatter</li>
              <li>Text Compare</li>
              <li>Cron Generator</li>
              <li>Base64 Encoder</li>
            </ul>
            <p class="dash-group">Guides</p>
            <ul>
              <li>English</li>
              <li>Tiếng Việt</li>
            </ul>
          </div>
          <div class="dash-main">
            <div class="dash-crumb">
              Tools › <b>JSON Formatter</b>
            </div>
            <div class="dash-banner">
              <div>
                <b>Format JSON right in your tab</b>
                <span>Nothing is uploaded. Nothing is saved.</span>
              </div>
              <span class="dash-btn">Format JSON →</span>
            </div>
            <div class="dash-cards">
              <div class="dash-card">
                <div class="dash-card-head">
                  JSON <span class="dash-tag">Input → Output</span>
                </div>
                <pre class="dash-code">{'{\n  '}"name": <span class="v">"api"</span>{',\n  '}"free": <span class="v">true</span>{',\n  '}"tools": <span class="v">8</span>{'\n}'}</pre>
              </div>
              <div class="dash-card">
                <div class="dash-card-head">
                  Work done <span class="dash-tag">In your browser</span>
                </div>
                <svg
                  class="px"
                  aria-hidden="true"
                  viewBox={`0 0 ${cols * cell} ${rows * cell}`}
                  focusable="false"
                >
                  {pixels.map((pixel) => (
                    <rect
                      class:list={[pixel.cls, { 'px-top': pixel.top }]}
                      x={pixel.x}
                      y={pixel.y}
                      width="8"
                      height="8"
                      rx="1.5"
                      style={pixel.top ? `--d:${pixel.delay}` : undefined}
                    />
                  ))}
                </svg>
                <p class="dash-foot">Your device does the work.</p>
              </div>
            </div>
            <div class="dash-card">
              <div class="dash-card-head">
                How it works <span class="dash-tag">Live</span>
              </div>
              <div class="dash-flow">
                <span class="dash-node">paste</span>
                <i></i>
                <span class="dash-node on">this tab</span>
                <i></i>
                <span class="dash-node">copy</span>
              </div>
            </div>
          </div>
        </div>
        <span class="hero-chip">
          <Icon name="shield" size={16} /> Your input stays in your browser
        </span>
      </div>
    </section>
    <section class="tools-section">
      <div class="section-heading">
        <div>
          <h2>A shortcut for your next task.</h2>
        </div>
        <span class="section-note">Eight useful tools. Zero hoops.</span>
      </div>
      <Directory />
    </section>
    <section class="flow" aria-labelledby="flow-title">
      <div class="flow-head">
        <h2 id="flow-title">How every tool works</h2>
        <p>
          Your data takes the shortest path: from your keyboard, through this
          tab, back to your clipboard.
        </p>
      </div>
      <ol class="flow-track">
        <li class="flow-node">
          <span class="node-box">
            <Icon name="copy" />
          </span>
          <strong>You paste</strong>
        </li>
        <li class="flow-link" aria-hidden="true"></li>
        <li class="flow-node">
          <span class="node-box run">in this browser tab</span>
          <strong>Processed locally</strong>
        </li>
        <li class="flow-link" aria-hidden="true"></li>
        <li class="flow-node">
          <span class="node-box">
            <Icon name="check" />
          </span>
          <strong>You copy</strong>
        </li>
        <li class="flow-link off" aria-hidden="true"></li>
        <li class="flow-node">
          <span class="node-box ghost">server</span>
          <span>Not used</span>
        </li>
      </ol>
    </section>
    <section class="features" aria-label="Why InfraTrove">
      <div class="feature">
        <div class="feature-icon">
          <Icon name="bolt" />
        </div>
        <h3>Open. Use. Done.</h3>
        <p>
          No account, installation or complicated setup. Just the tool you came
          for.
        </p>
      </div>
      <div class="feature">
        <div class="feature-icon">
          <Icon name="shield" />
        </div>
        <h3>Your input stays yours.</h3>
        <p>
          Tool processing happens in your browser. No uploads, tracking scripts
          or input history.
        </p>
      </div>
      <div class="feature">
        <div class="feature-icon">
          <Icon name="bookmark" />
        </div>
        <h3>Built to be bookmarked.</h3>
        <p>
          Clear controls, useful examples and a consistent place to get small
          tasks out of the way.
        </p>
      </div>
    </section>
    <section class="guides-section">
      <div class="section-heading">
        <div>
          <h2>Useful tools. Useful know-how.</h2>
        </div>
        <a class="text-link" href="/blog/">
          All guides <Icon name="arrow" size={16} />
        </a>
      </div>
      <div class="post-grid">
        {posts.map((post, i) => (
          <PostCard post={post} tone={i} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
