---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Directory from '../../components/Directory.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout
  title="All Free Online Tools"
  description="Browse free tools for text, JSON, encoding, passwords and scheduling. Search by task, filter by category or return to your favorites."
>
  <div class="container page-section tool-index">
    <header class="tool-index-intro banner">
      <div>
        <div class="eyebrow">The tool index</div>
        <h1>A tool for the little things.</h1>
        <p class="page-intro">Find the right tool. Finish the little things.</p>
      </div>
      <div class="hero-search">
        <label for="tool-search">Search tools</label>
        <div class="search-control">
          <Icon name="search" />
          <input
            id="tool-search"
            type="search"
            placeholder="Search tools, tasks or formats…"
            autocomplete="off"
          />
          <kbd>⌘ K</kbd>
        </div>
      </div>
    </header>
    <Directory />
  </div>
</BaseLayout>
