---
interface Props {
  slug: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}
const { slug, size = 22, strokeWidth = 1.5, class: className } = Astro.props;
---

<svg
  class:list={['tool-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
