  {slug === 'json-formatter' && (
    <g>
      <path d="M7 4C5.5 4 4.5 4.8 4.5 6.5V9c0 1.2-.8 2-2 2.5 1.2.5 2 1.3 2 2.5v2.5C4.5 19.2 5.5 20 7 20" />
