      {cells.map((i) => (
        <rect
          class={`a-ink ${i === 3 || i === 7 ? 'f-h3' : 'f-paper'}`}
          x={73 + i * 34}
          y="72"
          width="28"
          height="28"
          rx="6"
        />
      ))}
      <path class="a-ink a-bare a-bold" d="M182 86h14m-7-7v14M331 79l-12 14" />
      <path class="a-ink a-bare" d="M240 118v54m-9-12 9 12 9-12" />
      <rect
        class="a-ink a-dash f-paper"
        x="52"
        y="190"
        width="376"
        height="62"
        rx="31"
      />
      {cells.map((i) => (
        <rect
          class={`a-ink ${i === 3 || i === 7 ? 'f-accent' : 'f-paper'}`}
          x={73 + i * 34}
          y="207"
          width="28"
          height="28"
          rx="6"
        />
      ))}
      <path class="a-ink a-bare a-bold" d="M182 221h14M318 230h14" />
    </g>
  )}

  {slug === 'json-trailing-commas' && (
    <g>
      <rect
        class="a-ink f-paper"
        x="90"
        y="48"
        width="300"
        height="224"
        rx="16"
      />
      <path
        class="a-ink a-bare"
        d="M124 78c-14 0-14 6-14 18v42c0 8-6 12-12 12 6 0 12 4 12 12v42c0 12 0 18 14 18"
      />
      <rect class="f-h2" x="134" y="86" width="56" height="9" rx="4.5" />
      <rect class="f-line" x="198" y="86" width="96" height="9" rx="4.5" />
      <rect class="f-h2" x="134" y="124" width="72" height="9" rx="4.5" />
      <rect class="f-line" x="214" y="124" width="70" height="9" rx="4.5" />
      <rect class="f-h2" x="134" y="162" width="48" height="9" rx="4.5" />
      <rect class="f-line" x="190" y="162" width="84" height="9" rx="4.5" />
      <path
        class="a-red"
        d="M134 184q6-6 12 0t12 0 12 0 12 0 12 0 12 0 12 0 12 0 12 0 12 0"
      />
      <circle class="a-ink f-h3" cx="326" cy="166" r="20" />
      <circle class="f-ink" cx="326" cy="162" r="4.5" />
      <path class="a-ink a-bare" d="M326 166q0 9-6 13" />
      <circle class="a-ink f-h3" cx="400" cy="52" r="24" />
      <path class="a-ink a-bare" d="m391 43 18 18m0-18-18 18" />
    </g>
  )}

  {slug === 'unix-cron-basics' && (
    <g>
      <circle class="a-ink f-paper" cx="142" cy="112" r="64" />
      <path
        class="a-ink a-bare a-faint"
        d="M142 56v8M142 160v8M86 112h8M190 112h8M114 63l4 7M170 63l-4 7M114 161l4-7M170 161l-4-7"
      />
      <path class="a-ink a-bare" d="M142 112V76M142 112l26 14" />
      <circle class="a-ink f-h2" cx="142" cy="112" r="6" />
      <rect
        class="a-ink f-paper"
        x="248"
        y="48"
        width="180"
        height="136"
        rx="14"
      />
      <path
        class="a-ink f-h2"
        d="M248 62a14 14 0 0 1 14-14h152a14 14 0 0 1 14 14v18H248Z"
      />
      {calendar.map((i) => (
        <rect
          class={`a-ink ${lit.has(i) ? 'f-h1' : 'f-paper'}`}
          x={266 + (i % 5) * 32}
          y={94 + Math.floor(i / 5) * 28}
          width="24"
          height="20"
          rx="5"
        />
      ))}
      {[0, 1, 2, 3, 4].map((i) => (
        <g>
          <rect
            class={`a-ink ${i === 1 ? 'f-h1' : 'f-paper'}`}
            x={66 + i * 72}
            y="224"
            width="60"
            height="52"
            rx="12"
          />
          <path
            class="a-ink a-bare"
            d={`M${96 + i * 72} 240v20m-9-15 18 10m0-10-18 10`}
          />
        </g>
      ))}
      <path class="a-ink a-bare a-dash" d="M142 176v36M338 184v28" />
    </g>
  )}
  {/* A guide without its own scene still gets a framed page. */}
  {!scenes.includes(slug) && (
    <g>
      <rect
        class="a-ink f-paper"
        x="150"
        y="48"
        width="180"
        height="224"
        rx="16"
