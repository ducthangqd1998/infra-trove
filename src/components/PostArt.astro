      <rect class="f-line" x="176" y="118" width="128" height="8" rx="4" />
      <rect class="f-line" x="176" y="142" width="104" height="8" rx="4" />
      <rect class="f-line" x="176" y="166" width="118" height="8" rx="4" />
      <rect
        class="a-ink f-code"
        x="176"
        y="196"
        width="128"
        height="44"
        rx="8"
      />
    </g>
  )}
</svg>
