          class={`a-ink f-${tone}`}
          x={238 + i * 28}
          y="96"
          width="24"
          height="24"
          rx="5"
        />
      ))}
      {hex.map((tone, i) => (
        <rect
          class={`a-ink f-${tone}`}
          x={238 + i * 28}
          y="136"
          width="24"
          height="24"
          rx="5"
        />
      ))}
      <path class="a-ink a-bare" d="M350 170v28" />
      <circle class="a-ink f-accent" cx="350" cy="228" r="30" />
      <path class="a-ink a-bare" d="m336 228 10 10 20-22" />
    </g>
  )}

  {slug === 'yaml-json-conversion' && (
    <g>
      <rect
        class="a-ink f-paper"
        x="44"
        y="62"
        width="156"
        height="196"
        rx="14"
      />
      <circle class="f-h2" cx="70" cy="96" r="5" />
      <rect class="f-line" x="84" y="92" width="86" height="8" rx="4" />
      <rect class="f-line" x="70" y="122" width="60" height="8" rx="4" />
      <circle class="f-h2" cx="94" cy="150" r="5" />
      <rect class="f-line" x="108" y="146" width="56" height="8" rx="4" />
      <circle class="f-h2" cx="94" cy="176" r="5" />
      <rect class="f-line" x="108" y="172" width="44" height="8" rx="4" />
      <rect class="f-line" x="70" y="202" width="72" height="8" rx="4" />
      <rect class="f-line" x="70" y="226" width="40" height="8" rx="4" />
      <rect
        class="a-ink f-code"
        x="280"
        y="62"
        width="156"
        height="196"
        rx="14"
      />
      <path
        class="a-ink a-bare"
        d="M310 98c-12 0-12 6-12 18s-6 14-10 14c4 0 10 2 10 14s0 18 12 18M406 98c12 0 12 6 12 18s6 14 10 14c-4 0-10 2-10 14s0 18-12 18"
