---
// One flat line illustration per guide, drawn from the design tokens so it
// follows light and dark. Decorative: the article text carries the meaning.
interface Props {
  slug: string;
}
const { slug } = Astro.props;
const scenes = [
  'jwt-claims-without-verification',
  'storage-units-gb-gib',
  'verify-file-checksum',
  'yaml-json-conversion',
  'base64-vs-base64url',
  'json-trailing-commas',
  'unix-cron-basics',
];
const hex = ['h1', 'h2', 'paper', 'h3', 'paper', 'h2', 'h1', 'paper'];
const cells = [...Array(10).keys()];
const calendar = [...Array(15).keys()];
const lit = new Set([2, 5, 6, 11]);
---

<svg
  class="art"
  viewBox="0 0 480 320"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <rect class="art-stage" width="480" height="320"></rect>
  <g class="art-arcs">
    <circle cx="410" cy="50" r="44"></circle>
    <circle cx="410" cy="50" r="88"></circle>
    <circle cx="410" cy="50" r="132"></circle>
    <circle cx="410" cy="50" r="176"></circle>
  </g>

  {slug === 'jwt-claims-without-verification' && (
    <g transform="translate(0 10)">
      <rect
        class="a-ink f-paper"
        x="70"
        y="56"
        width="340"
        height="64"
        rx="14"
      />
      <path
        class="a-ink f-h1"
        d="M70 70a14 14 0 0 1 14-14h66v64H84a14 14 0 0 1-14-14Z"
      />
      <rect class="a-ink f-h2" x="150" y="56" width="140" height="64" />
      <path
        class="a-ink f-h3"
        d="M290 56h106a14 14 0 0 1 14 14v36a14 14 0 0 1-14 14H290Z"
      />
      <circle class="f-ink" cx="150" cy="88" r="5" />
      <circle class="f-ink" cx="290" cy="88" r="5" />
      <path
        class="a-ink a-bare"
        d="M110 120c0 26-20 26-20 50M220 120v50M350 120c0 26 20 26 20 50"
      />
      <rect
        class="a-ink f-paper"
        x="40"
        y="170"
        width="100"
        height="96"
        rx="12"
      />
      <rect class="f-line" x="56" y="192" width="68" height="8" rx="4" />
      <rect class="f-line" x="56" y="212" width="48" height="8" rx="4" />
      <rect class="f-line" x="56" y="232" width="58" height="8" rx="4" />
      <rect
        class="a-ink f-paper"
        x="170"
        y="170"
        width="100"
        height="96"
        rx="12"
      />
      <rect class="f-line" x="186" y="192" width="68" height="8" rx="4" />
      <rect class="f-line" x="186" y="212" width="58" height="8" rx="4" />
      <rect class="f-line" x="186" y="232" width="40" height="8" rx="4" />
      <rect
        class="a-ink f-paper a-dash"
        x="300"
        y="170"
        width="140"
        height="96"
        rx="12"
      />
      <rect class="a-ink f-h1" x="352" y="214" width="36" height="30" rx="6" />
      <path class="a-ink a-bare" d="M360 214v-12a10 10 0 0 1 20 0" />
      <circle class="f-ink" cx="370" cy="229" r="3.5" />
    </g>
  )}

  {slug === 'storage-units-gb-gib' && (
    <g>
      <path class="a-ink f-paper" d="M100 168v76a50 14 0 0 0 100 0v-76Z" />
      <ellipse class="a-ink f-paper" cx="150" cy="168" rx="50" ry="14" />
      <path
        class="a-ink a-bare a-faint"
        d="M100 196a50 14 0 0 0 100 0M100 220a50 14 0 0 0 100 0"
      />
      <path class="a-ink f-h1" d="M290 140v104a50 14 0 0 0 100 0V140Z" />
      <ellipse class="a-ink f-h2" cx="340" cy="140" rx="50" ry="14" />
      <path
        class="a-ink a-bare a-faint"
        d="M290 170a50 14 0 0 0 100 0M290 200a50 14 0 0 0 100 0M290 228a50 14 0 0 0 100 0"
      />
      <path class="a-ink a-bare a-dash" d="M150 154H410" />
      <path class="a-ink a-bare" d="M418 140v28m-6-22 6-6 6 6m-12 16 6 6 6-6" />
      <path class="a-ink a-bare" d="M222 196h48M222 214h48M232 184l28 42" />
    </g>
  )}

  {slug === 'verify-file-checksum' && (
    <g>
      <path class="a-ink f-paper" d="M60 70h76l34 34v138H60Z" />
      <path class="a-ink a-bare" d="M136 70v34h34" />
      <rect class="f-line" x="80" y="130" width="70" height="8" rx="4" />
      <rect class="f-line" x="80" y="152" width="54" height="8" rx="4" />
