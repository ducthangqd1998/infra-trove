---
import Icon from './Icon.astro';
import ToolIcon from './ToolIcon.astro';
import { getTool } from '../data/tools';
import { blogText } from '../lib/i18n';
import { postHref, postLang, postSlug, type Post } from '../lib/blog';

interface Props {
  post: Post;
  /** Marks the newest guide with a badge. */
  latest?: boolean;
  /** Heading level, so the card nests under the section heading around it. */
  heading?: 'h2' | 'h3';
}
const { post, latest = false, heading: Heading = 'h3' } = Astro.props;
const lang = postLang(post);
const t = blogText[lang];
const tool = post.data.tool ? getTool(post.data.tool) : null;
const href = postHref(lang, postSlug(post));
---

<article
  class="post-card"
  lang={lang}
  data-post
  data-category={post.data.category}
>
  <div class="card-top">
    <span class="card-category">
      {tool ? (
        <ToolIcon slug={tool.slug} size={16} />
      ) : (
        <Icon name="book" size={16} />
      )}
      {post.data.category}
    </span>
    {latest && <span class="badge">{t.featured}</span>}
  </div>
  <Heading>
    <a href={href}>{post.data.title}</a>
  </Heading>
  <p>{post.data.description}</p>
  <div class="card-foot">
    <span class="card-tags">{post.data.readingTime}</span>
    <span class="card-link">
      {t.openGuide}
      <Icon name="arrow" size={15} />
    </span>
  </div>
</article>
