---
import Icon from './Icon.astro';
import ToolIcon from './ToolIcon.astro';
import type { Tool } from '../data/tools';
interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
---

<article
  class="tool-card"
  data-tool-card
  data-slug={tool.slug}
  data-category={tool.category}
  data-search={`${tool.title} ${tool.category} ${tool.tags.join(' ')}`.toLowerCase()}
>
  <div class="card-top">
    <span class="tool-symbol" aria-hidden="true">
      <ToolIcon slug={tool.slug} size={24} />
    </span>
    <div class="card-top-actions">
      <span class="card-category">{tool.category}</span>
      <button
        type="button"
        class="card-fav-btn"
        data-fav-btn={tool.slug}
        aria-label={`Save ${tool.shortTitle} to favorites`}
        title="Save to favorites"
      >
        <Icon name="star" size={15} />
      </button>
    </div>
  </div>
  <div class="card-body">
    <h3>
      <a href={`/tools/${tool.slug}/`}>{tool.shortTitle}</a>
    </h3>
    <p>{tool.summary}</p>
  </div>
  <div class="card-foot">
    <div class="card-tags">
      {tool.tags.slice(0, 2).map((tag) => (
        <span class="tag-pill">{tag}</span>
      ))}
    </div>
    <span class="card-link" aria-hidden="true">
      Open tool <Icon name="arrow" size={15} />
    </span>
  </div>
</article>
