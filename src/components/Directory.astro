---
import { tools, categories } from '../data/tools';
import ToolCard from './ToolCard.astro';
import Icon from './Icon.astro';
---

<section class="directory" aria-label="Browse tools">
  <h2 class="sr-only">Browse tools</h2>
  <div class="directory-toolbar">
    <div class="tabs" role="group" aria-label="Filter by category">
      {categories.map((category, i) => (
        <button
          class:list={['chip', { active: i === 0 }]}
          data-filter={category}
          aria-pressed={i === 0}
        >
          {category}
        </button>
      ))}
      <button class="chip" data-filter="Favorites" aria-pressed="false">
        <Icon name="star" size={16} />
        &nbsp;Favorites
      </button>
    </div>
    <span class="result-count" aria-live="polite">
      <span class="count-pill">
        <span id="tool-count">{tools.length}</span> tools
      </span>
    </span>
  </div>
  <div class="tool-grid">
    {tools.map((tool) => (
      <ToolCard tool={tool} />
    ))}
  </div>
  <div id="empty-results" class="empty-state-card" hidden>
    <div class="empty-state-icon" aria-hidden="true">
      <Icon name="search" size={26} />
    </div>
    <h3>No matching tools</h3>
    <p>
      We couldn't find any tool matching your search. Try another keyword or
      reset the filter.
    </p>
    <button type="button" class="text-button" id="clear-search-btn">
      Reset search
    </button>
  </div>
</section>
<script>
  import { searchTools, type SearchTool } from '../lib/tool-search';
  let active = 'All tools';
  const input = document.getElementById(
    'tool-search',
  ) as HTMLInputElement | null;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tool-card]')];
  const searchIndex: SearchTool[] = cards.map((card) =>
    JSON.parse(card.dataset.search!),
  );
  function readFavorites(): string[] {
    try {
      const saved = JSON.parse(
        localStorage.getItem('infratrove-favorites') || '[]',
      );
      return Array.isArray(saved)
        ? saved.filter((x) => typeof x === 'string')
        : [];
    } catch {
      return [];
    }
  }
  function writeFavorites(favs: string[]) {
    try {
      localStorage.setItem('infratrove-favorites', JSON.stringify(favs));
    } catch {}
  }
  function syncFavoriteButtons() {
    const favs = readFavorites();
    document
      .querySelectorAll<HTMLButtonElement>('[data-fav-btn]')
      .forEach((btn) => {
        const slug = btn.dataset.favBtn || '';
        const isFav = favs.includes(slug);
        btn.setAttribute('aria-pressed', String(isFav));
        btn.classList.toggle('is-favorite', isFav);
        btn.setAttribute(
          'title',
          isFav ? 'Remove from favorites' : 'Save to favorites',
        );
      });
  }
  syncFavoriteButtons();
  document
    .querySelectorAll<HTMLButtonElement>('[data-fav-btn]')
    .forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = btn.dataset.favBtn || '';
        if (!slug) return;
        const favs = readFavorites();
        const next = favs.includes(slug)
          ? favs.filter((s) => s !== slug)
          : [...favs, slug];
        writeFavorites(next);
        syncFavoriteButtons();
        if (active === 'Favorites') filter();
      });
    });
  function filter() {
    const favorites = readFavorites();
    const query = input?.value.toLowerCase().trim() || '';
    const matches = searchTools(searchIndex, query);
    const slugs = new Set(matches.map((tool) => tool.slug));
    if (query)
      matches.forEach((tool) => {
        const card = cards.find((card) => card.dataset.slug === tool.slug)!;
        card.parentElement!.append(card);
      });
    else cards.forEach((card) => card.parentElement!.append(card));
    let count = 0;
    cards.forEach((card) => {
      const visible =
        slugs.has(card.dataset.slug || '') &&
        (active === 'All tools' ||
          (active === 'Favorites'
            ? favorites.includes(card.dataset.slug || '')
            : card.dataset.category === active));
      card.hidden = !visible;
      if (visible) count++;
    });
    const countElement = document.getElementById('tool-count');
    if (countElement) countElement.textContent = String(count);
    document
      .getElementById('empty-results')
      ?.toggleAttribute('hidden', count > 0);
  }
  input?.addEventListener('input', filter);
  document.getElementById('clear-search-btn')?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      filter();
      input.focus();
    }
  });
  document
    .querySelectorAll<HTMLButtonElement>('[data-filter]')
    .forEach((button) =>
      button.addEventListener('click', () => {
        active = button.dataset.filter || 'All tools';
        document
          .querySelectorAll<HTMLButtonElement>('[data-filter]')
          .forEach((item) => {
            item.classList.toggle('active', item === button);
            item.setAttribute('aria-pressed', String(item === button));
          });
        filter();
      }),
    );
  if (location.hash === '#tool-search') input?.focus();
</script>
