---
import { tools } from '../data/tools';
import Icon from './Icon.astro';
import ToolIcon from './ToolIcon.astro';
const index = tools.map(({ slug, title, summary, tags, category }) => ({
  slug,
  title,
  summary,
  tags: [...tags, category],
}));
---

<dialog
  id="quick-search"
  class="quick-search"
  aria-labelledby="quick-search-title"
  data-index={JSON.stringify(index)}
>
  <h2 id="quick-search-title" class="sr-only">
    Find a tool
  </h2>
  <div class="quick-search-heading">
    <Icon name="search" size={20} />
    <label class="sr-only" for="quick-search-input">
      Search tools
    </label>
    <input
      id="quick-search-input"
      type="text"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="true"
      aria-controls="quick-search-results"
      placeholder="Search tools…"
      autocomplete="off"
      spellcheck="false"
      autofocus
    />
    <button
      type="button"
      class="icon-button"
      data-search-close
      aria-label="Close search"
    >
      <Icon name="close" size={20} />
    </button>
  </div>
  <div class="quick-search-body">
    <p
      class="quick-search-count"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></p>
    <ul id="quick-search-results" role="listbox" aria-label="Tools">
      {tools.map((tool) => (
        <li
          id={`quick-${tool.slug}`}
          role="option"
          aria-selected="false"
          data-search-slug={tool.slug}
        >
          <span class="quick-search-icon">
            <ToolIcon slug={tool.slug} size={20} />
          </span>
          <span class="quick-search-copy">
            <span class="quick-search-name-row">
              <span class="quick-search-name">{tool.title}</span>
              <span class="quick-search-category">{tool.category}</span>
            </span>
            <span class="quick-search-summary">{tool.summary}</span>
          </span>
          <span class="quick-search-open" aria-hidden="true">
            <span class="quick-search-open-label">Open</span>
            <Icon name="arrow" size={14} />
          </span>
        </li>
      ))}
    </ul>
    <div class="quick-search-empty" hidden>
      <p>
        No tools found for “<span data-search-query></span>”.
      </p>
      <p>Try a tool name or keyword, such as “diff” or “epoch”.</p>
      <button type="button" class="text-button" data-search-clear>
        Clear search
      </button>
    </div>
  </div>
  <div class="quick-search-footer" aria-hidden="true">
    <span>
      <kbd>↑</kbd>
      <kbd>↓</kbd> Navigate
    </span>
    <span>
      <kbd>Enter</kbd> Open
    </span>
    <span>
      <kbd>Esc</kbd> Close
    </span>
  </div>
</dialog>

<script>
  import { searchTools, type SearchTool } from '../lib/tool-search';
  const dialog = document.getElementById('quick-search') as HTMLDialogElement;
  const input = dialog.querySelector('input')!;
  const trigger =
    document.querySelector<HTMLAnchorElement>('[data-search-open]')!;
  const list = dialog.querySelector<HTMLUListElement>('[role="listbox"]')!;
  const options = new Map(
    [...list.querySelectorAll<HTMLElement>('[role="option"]')].map((option) => [
      option.dataset.searchSlug!,
      option,
    ]),
  );
  const index: SearchTool[] = JSON.parse(dialog.dataset.index!);
  let results: SearchTool[] = [];
  let selected = -1;
  let previousFocus: HTMLElement | null = null;

  function select(next: number, scroll = true) {
    selected = next;
    options.forEach((option) => option.setAttribute('aria-selected', 'false'));
    const option = options.get(results[selected]?.slug);
    if (option) {
      option.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', option.id);
      if (scroll) option.scrollIntoView({ block: 'nearest' });
    } else input.removeAttribute('aria-activedescendant');
  }
  function filter() {
    results = searchTools(index, input.value);
    options.forEach((option) => {
      option.hidden = true;
    });
    results.forEach((tool) => {
      const option = options.get(tool.slug)!;
      option.hidden = false;
      list.append(option);
    });
    dialog.querySelector('[role="status"]')!.textContent =
      `${results.length} ${results.length === 1 ? 'tool' : 'tools'}${input.value.trim() ? ' found' : ' available'}`;
    dialog.querySelector<HTMLElement>('.quick-search-empty')!.hidden =
      results.length > 0;
    dialog.querySelector('[data-search-query]')!.textContent = input.value;
    select(results.length ? 0 : -1, false);
    dialog.querySelector('.quick-search-body')!.scrollTop = 0;
  }
  function open() {
    if (dialog.open || document.querySelector('dialog[open]')) return;
    previousFocus =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : trigger;
    input.value = '';
    filter();
    syncViewport();
    dialog.showModal();
    document.documentElement.classList.add('search-open');
    trigger.setAttribute('aria-expanded', 'true');
    input.focus();
  }
  function activate() {
    const tool = results[selected];
    if (tool) window.location.assign(`/tools/${tool.slug}/`);
  }
  trigger.setAttribute('role', 'button');
  trigger.setAttribute('aria-haspopup', 'dialog');
  trigger.setAttribute('aria-controls', dialog.id);
  trigger.setAttribute('aria-expanded', 'false');
  const shortcut = /Mac|iPhone|iPad/.test(navigator.platform)
    ? '⌘ K'
    : 'Ctrl K';
  document.querySelectorAll('[data-search-shortcut]').forEach((hint) => {
    hint.textContent = shortcut;
  });
  trigger.addEventListener('click', (event) => {
    event.preventDefault();
    open();
  });
  trigger.addEventListener('keydown', (event) => {
    if (event.key === ' ') {
      event.preventDefault();
      open();
    }
  });
  document.addEventListener('keydown', (event) => {
    if (
      (event.metaKey || event.ctrlKey) &&
      !event.altKey &&
      !event.shiftKey &&
      event.key.toLowerCase() === 'k' &&
      !event.isComposing
    ) {
      if (document.querySelector('dialog[open]') && !dialog.open) return;
      event.preventDefault();
      if (dialog.open) input.focus();
      else open();
    }
  });
  input.addEventListener('input', filter);
  input.addEventListener('keydown', (event) => {
    if (event.isComposing) return;
    if (
      (event.key === 'ArrowDown' || event.key === 'ArrowUp') &&
      results.length
    ) {
      event.preventDefault();
      select(
        Math.max(
          0,
          Math.min(
            results.length - 1,
            selected + (event.key === 'ArrowDown' ? 1 : -1),
          ),
        ),
      );
    } else if (event.key === 'Enter') {
      event.preventDefault();
      activate();
    }
  });
  list.addEventListener('pointerdown', (event) => {
    if (event.pointerType === 'mouse') event.preventDefault();
  });
  list.addEventListener('pointermove', (event) => {
    if (event.pointerType === 'touch') return;
    const option = (event.target as Element).closest<HTMLElement>(
      '[data-search-slug]',
    );
    if (!option || option.hidden) return;
    const next = results.findIndex(
      (tool) => tool.slug === option.dataset.searchSlug,
    );
    if (next !== selected) select(next, false);
  });
  list.addEventListener('click', (event) => {
    const option = (event.target as Element).closest<HTMLElement>(
      '[data-search-slug]',
    );
    if (!option || option.hidden) return;
    select(
      results.findIndex((tool) => tool.slug === option.dataset.searchSlug),
      false,
    );
    activate();
  });
  dialog
    .querySelector('[data-search-close]')!
    .addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-search-clear]')!.addEventListener('click', () => {
    input.value = '';
    filter();
    input.focus();
  });
  dialog.addEventListener('click', (event) => {
    const rect = dialog.getBoundingClientRect();
    if (
      event.target === dialog &&
      (event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom)
    )
      dialog.close();
  });
  dialog.addEventListener('close', () => {
    document.documentElement.classList.remove('search-open');
    trigger.setAttribute('aria-expanded', 'false');
    previousFocus?.focus({ preventScroll: true });
  });
  // Keep Tab inside the search controls, including when the empty state appears.
  dialog.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab') return;
    const controls = [
      ...dialog.querySelectorAll<HTMLElement>('input, button'),
    ].filter((element) => element.getClientRects().length > 0);
    const first = controls[0];
    const last = controls.at(-1);
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });
  function syncViewport() {
    dialog.style.setProperty(
      '--search-viewport-height',
      `${window.visualViewport?.height ?? window.innerHeight}px`,
    );
  }
  window.visualViewport?.addEventListener('resize', syncViewport);
</script>
