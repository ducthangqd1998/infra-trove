---
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className } = Astro.props;
---

<svg
  class:list={['brand-logo', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <!-- Top Vault Slab (Signature Orange) -->
  <path d="M12 3L20.5 7.5L12 12L3.5 7.5L12 3Z" fill="#ff6b35" />
  <!-- Terminal Prompt symbol on Top Slab -->
  <path
    d="M10 6.5L12.5 8L10 9.5"
    stroke="#1c1917"
    stroke-width="1.3"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Mid Platform Layer -->
  <path
    d="M3.5 12L12 16.5L20.5 12"
    stroke="#ea580c"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <!-- Foundation Layer -->
  <path
    d="M3.5 16.5L12 21L20.5 16.5"
    stroke="#a8a29e"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
