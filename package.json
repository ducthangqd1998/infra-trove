{
  "name": "infratrove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && tsc -p worker",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "dev:api": "astro build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply infratrove-comments --local",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:static": "node scripts/check-static.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "pnpm run build && wrangler deploy",
    "types:worker": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.2",
    "cron-parser": "^5.10.2",
    "cronstrue": "^3.38.0",
    "diff": "^9.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <26"
  }
}
